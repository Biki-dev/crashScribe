# CrashScribe Local Development Environment Variables

# Environment
NODE_ENV=development
ENVIRONMENT=local

# Network / Gateway Configuration
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
JWT_SECRET=crashscribe_super_secret_jwt_dev_key_2026_assam_police_traffic
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d

# Microservice Target URLs (Used by Go API Gateway)
AUTH_SERVICE_URL=http://localhost:5001
REPORT_SERVICE_URL=http://localhost:5002
EVIDENCE_SERVICE_URL=http://localhost:5003
ANALYTICS_SERVICE_URL=http://localhost:5004

# Service Ports
AUTH_PORT=5001
REPORT_PORT=5002
EVIDENCE_PORT=5003
ANALYTICS_PORT=5004

# Database Connections (Native PostgreSQL)
AUTH_DB_URL=postgres://localhost:5432/crashscribe_auth?sslmode=disable
REPORTS_DB_URL=postgres://localhost:5432/crashscribe_reports?sslmode=disable
ANALYTICS_DB_URL=postgres://localhost:5432/crashscribe_analytics?sslmode=disable

# In-Memory / Distributed Lock Flags
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# Event Broker (RabbitMQ)
USE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Evidence Storage Configuration
# local: files saved to backend/storage/uploads
# r2: Cloudflare R2 bucket
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./backend/storage/uploads
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=crashscribe-evidence
